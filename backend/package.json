{
  "name": "vriends-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "prisma migrate deploy && node server.js",
    "dev": "node ./scripts/run-with-local-modules.js nodemon server.js",
    "dev:direct": "node ./scripts/run-with-local-modules.js node server.js",
    "test": "node --test tests/**/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:migrate-from-sqlite": "node scripts/migrate-sqlite-to-pg.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "6.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "overrides": {
    "minimist": "^1.2.8",
    "semver": "^7.6.3"
  }
}
